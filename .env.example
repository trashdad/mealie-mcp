# --- Mealie ---
# URL of your Mealie instance as reachable FROM THIS CONTAINER (LAN address is fine)
MEALIE_URL=http://192.168.1.50:9925
# Mealie > User settings > API Tokens > create a long-lived token
MEALIE_API_TOKEN=change-me

# --- This server ---
# The public HTTPS URL Claude will use to reach this server (no trailing slash, no /mcp).
# Claude's connector URL will be PUBLIC_URL + /mcp
PUBLIC_URL=https://mealie-mcp.example.com
# Password you type on the login page when connecting Claude. Make it long.
MCP_LOGIN_PASSWORD=change-me-to-something-long
# Optional overrides
#MCP_HOST=0.0.0.0
#MCP_PORT=8000
#MCP_DATA_DIR=/data
#MCP_ACCESS_TOKEN_TTL=3600
#MCP_REFRESH_TOKEN_TTL=2592000
#MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,http://localhost/callback,http://127.0.0.1/callback

# --- Optional: Cloudflare Tunnel (docker compose --profile cloudflared up -d) ---
#TUNNEL_TOKEN=

# --- Optional: nutrition lookups (lookup_nutrition tool) ---
# Free key, takes a couple minutes: https://fdc.nal.usda.gov/api-key-signup.html
# Without one, requests fall back to the shared DEMO_KEY, which is fine for
# occasional lookups but heavily rate-limited for bulk-processing a recipe collection.
#USDA_API_KEY=change-me
